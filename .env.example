# ── Database ───────────────────────────────────────────────
MONGODB_URI=

# ── Sessions ───────────────────────────────────────────────
# NEXTAUTH_SECRET signs session cookies and tokens (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=
# Public base URL of the app, used in email links and payment redirects.
NEXTAUTH_URL=http://localhost:3000

# ── Cloudinary (image uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder that uploads are stored in (default "nexora")
CLOUDINARY_FOLDER=nexora

# ── Email (SMTP) ───────────────────────────────────────────
# When SMTP_HOST is empty, emails are printed to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: From address, e.g. "Nexora <hello@yourdomain.com>" (defaults to SMTP_USER)
SMTP_FROM=

# ── Initial admin (npm run seed:admin) ────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Payments (optional) ────────────────────────────────────
# Leave empty to run with the "pay on delivery / at appointment" provider only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Require verified email before checkout/booking (true|false, default true)
REQUIRE_EMAIL_VERIFICATION=true
